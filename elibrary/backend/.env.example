# ---------- Server ----------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/elibrary
# Ya MongoDB Atlas (free cloud) ka connection string yahan paste karein:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/elibrary

# Agar MONGO_URI khaali chhod dein, to app apna in-memory demo database
# khud start kar lega (sirf testing ke liye - restart par data delete ho jata hai).

# ---------- Auth ----------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Library rules ----------
LOAN_PERIOD_DAYS=14
FINE_PER_DAY=5
MAX_BOOKS_PER_STUDENT=3
MAX_RENEWALS=1

# ---------- Server ----------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/elibrary
# Or paste a MongoDB Atlas (free cloud) connection string here:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/elibrary

# Leave MONGO_URI empty and the app starts its own in-memory demo database
# (testing only - all data is lost when the server restarts).

# ---------- Auth ----------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Library rules ----------
LOAN_PERIOD_DAYS=14
FINE_PER_DAY=5
MAX_BOOKS_PER_STUDENT=3
MAX_RENEWALS=1
